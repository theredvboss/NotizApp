<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" Width="350" Height="100"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        x:Class="NotizApp.DialogJaNein"
        Title="Bist du sicher?">

        <StackPanel Margin="20" Spacing="15">
                <TextBlock Text="Willst du die App schließen?" FontSize="20" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Name="YesButton" Content="Ja" Width="80"/>
                        <Button Name="NoButton" Content="Nein" Width="80"/>
                </StackPanel>
        </StackPanel>
        
</Window>
